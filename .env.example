# JimQ environment template (S0). Copy to .env and adjust.
# localhost-only per DEV_CONTRACT_AFK 鐵律 4. .env is gitignored.

# --- Postgres (application data only) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=jimq
# Async SQLAlchemy URL used by the FastAPI backend:
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/jimq

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Nautilus message bus / command streams DB index.
REDIS_BUS_DB=0
# FastAPI boilerplate cache DB index — MUST differ from REDIS_BUS_DB so the
# Nautilus bus/streams and the app cache stay isolated (鐵律 5 / jimq_core.constants).
REDIS_CACHE_DB=1

# --- MLflow experiment tracking (#16, profile=research) ---
# Host port for the docker MLflow server (localhost-only). Default 5000 (free).
MLFLOW_PORT=5000
# research training/runner points here when set; unset -> local sqlite fallback
# (data/mlflow/mlflow.db). Start the server with:
#   docker compose --profile research up -d mlflow
MLFLOW_TRACKING_URI=http://localhost:5000
