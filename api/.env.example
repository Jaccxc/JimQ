# jimq-api settings template. Copy to api/.env to override defaults.
# Defaults already match the root docker-compose (localhost), so .env is optional.

# --- App metadata ---
APP_NAME=JimQ API
APP_VERSION=0.1.0
ENVIRONMENT=local

# --- Postgres (application data only; localhost per 鐵律 4) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=jimq

# --- Redis cache (DB index isolated from Nautilus bus on DB 0; 鐵律 5) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_DB=1
